# Next.js server-side fallback API settings.
# Copy this file to .env.local for local frontend runs.
MEDCORE_DEMO_DATA=false
PATIENT_DEMO_PASSWORD=

# Server-only Gemini key used by lab image OCR when Next fallback APIs are used.
# ⚠️ Бодит key-г энд БҮҮ бич — энэ файл git-д ордог. Зөвхөн .env.local-д бич.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
