DATABASE_URL=postgresql+psycopg://medcore:medcore@localhost:5432/medcore
JWT_SECRET=change-me-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=production
PATIENT_UPLOAD_DIR=storage/patient_uploads
TESSERACT_LANGUAGES=eng+mon

# Local inference. Requires `ollama serve` running and these models pulled
# (ollama pull qwen2.5:7b-instruct && ollama pull qwen2.5vl:7b).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Local embedding model (sentence-transformers, runs in-process).
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
RAG_TOP_K=6

# Local demo only. Keep false/empty in production.
MEDCORE_DEMO_DATA=false
DEMO_STAFF_PASSWORD=
DEMO_PATIENT_PASSWORD=
