# Postgres (with pgvector) is required for any ENVIRONMENT other than
# "development" - config.py rejects a sqlite DATABASE_URL outside dev so a
# single-file DB can't quietly end up backing a horizontally scaled deployment.
DATABASE_URL=postgresql+psycopg://medcore:medcore@localhost:5432/medcore

# Dev-only fallback: sqlite is fine for local single-instance work, but only
# when ENVIRONMENT=development (the default). Uncomment to use it locally
# instead of running the docker-compose Postgres service.
# DATABASE_URL=sqlite:///./medcore_dev.db

JWT_SECRET=change-me-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=production
PATIENT_UPLOAD_DIR=storage/patient_uploads
TESSERACT_LANGUAGES=eng+mon

# Optional. When set, the login rate limiter and token revocation store use
# Redis instead of in-process memory / Postgres, so both are shared across
# every backend instance. Leave unset for single-instance/dev use.
# REDIS_URL=redis://localhost:6379/0

# Local inference. Requires `ollama serve` running and these models pulled
# (ollama pull qwen2.5:7b-instruct && ollama pull qwen2.5vl:7b).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Local embedding model (sentence-transformers, runs in-process).
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
RAG_TOP_K=6

# Local demo only. Keep false/empty in production.
MEDCORE_DEMO_DATA=false
DEMO_STAFF_PASSWORD=
DEMO_PATIENT_PASSWORD=
